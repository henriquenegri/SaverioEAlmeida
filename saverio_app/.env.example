# Domínio oficial. Copie para .env.local apenas para desenvolvimento local.
SITE_URL=https://saverioadvocacia.com.br

# Libere somente na hospedagem oficial. Prévia/local devem manter false.
SITE_INDEXABLE=false

# Opcional: valor da meta tag fornecida pelo Google Search Console.
# A verificação por DNS dispensa esta variável.
GOOGLE_SITE_VERIFICATION=
